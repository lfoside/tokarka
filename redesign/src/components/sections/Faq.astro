---
import { site, faq } from '../../data/site';
---

<!-- Вопрос-ответ: details/summary без JavaScript (правило 5.7) -->
<section id="faq" aria-labelledby="faq-title" class="py-section" data-reveal>
  <div class="mx-auto grid max-w-7xl gap-12 px-gutter lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
    <header class="lg:sticky lg:top-28 lg:self-start">
      <h2 id="faq-title" class="text-h2 text-balance">Частые вопросы</h2>
      <p class="mt-5 text-lead text-pretty text-muted-foreground">
        Не нашли ответ? Позвоните или напишите нам в мессенджер — ответим в течение рабочего дня.</p
      >
      <a
        href={site.phoneHref}
        class="mt-6 inline-flex items-center gap-2 font-mono text-meta font-bold text-primary-ink underline decoration-primary-ink/35 underline-offset-4 transition-colors duration-200 hover:decoration-primary-ink"
      >
        <svg class="contact-icon" aria-hidden="true"><use href="#i-phone"></use></svg>{site.phone}</a
      >
    </header>

    <div class="border-y border-border">
      {
        faq.map((item, index) => (
          <details class="group border-b border-border last:border-b-0" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-h4 font-bold [&::-webkit-details-marker]:hidden">
              <span class="text-pretty">{item.q}</span>
              <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-sm border border-border text-muted-foreground transition-colors duration-200 group-open:border-primary group-open:bg-primary group-open:text-primary-foreground">
                <!-- Открыто: «−» виден, «+» скрыт. Закрыто: наоборот. -->
                <svg class="size-4 group-open:hidden" aria-hidden="true"><use href="#i-plus"></use></svg>
                <svg class="hidden size-4 group-open:block" aria-hidden="true"><use href="#i-minus"></use></svg>
              </span>
            </summary>
            <p class="max-w-[66ch] pb-6 text-prose text-muted-foreground">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
