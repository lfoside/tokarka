---
import { site, nav } from '../data/site';
import MessengerLinks from './MessengerLinks.astro';
---

<!-- Подвал: блок контактов -->
<footer id="contacts" class="bg-steel text-white">
  <div class="mx-auto max-w-7xl px-gutter">
    <div class="flex flex-col gap-8 border-b border-white/10 py-14 md:flex-row md:items-center md:justify-between md:gap-12">
      <div class="max-w-xl">
        <h2 class="text-h2 text-balance">Пришлите чертёж — рассчитаем за 1–3 дня</h2>
        <p class="mt-4 text-lead text-white/65">DXF, STEP, DWG, PDF или фото образца. На почту или в мессенджер.</p>
      </div>
      <div class="flex shrink-0 flex-col items-start gap-4 md:items-end">
        <a
          href={site.mailtoSubject}
          class="inline-flex h-12 items-center justify-center rounded-sm bg-primary px-6 font-semibold text-primary-foreground transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-primary/90"
        >
          Отправить на {site.email}</a
        >
        <MessengerLinks />
      </div>
    </div>

    <div class="grid gap-10 py-12 md:grid-cols-3">
      <div>
        <span class="flex items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-primary text-primary-foreground">
            <svg class="size-6" aria-hidden="true"><use href="#i-logo"></use></svg>
          </span>
          <span class="flex flex-col leading-none">
            <span class="font-display text-lg font-semibold tracking-wide uppercase"
              >Токарка <span class="text-primary">Про</span></span
            >
            <span class="mt-1.5 font-mono text-micro uppercase text-white/55">металлообработка ЧПУ</span>
          </span>
        </span>
        <p class="mt-5 max-w-xs text-prose text-white/60">
          Токарно-фрезерная обработка на ЧПУ, сварочные и слесарные работы. Штучное и серийное производство с 2002
          года.</p
        >
      </div>

      <nav aria-label="Навигация в подвале">
        <h3 class="font-mono text-micro uppercase text-white/65">Разделы</h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="underline decoration-white/20 underline-offset-4 transition-colors duration-200 hover:text-primary hover:decoration-primary/60"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <address class="not-italic">
        <h3 class="font-mono text-micro uppercase text-white/65">Контакты</h3>
        <ul class="mt-4 grid gap-3 text-sm">
          <li>
            <a
              href={site.phoneHref}
              class="flex items-center gap-2 font-mono text-lg font-bold transition-colors duration-200 hover:text-primary"
            >
              <svg class="contact-icon" aria-hidden="true"><use href="#i-phone"></use></svg>{site.phone}</a
            >
          </li>
          <li>
            <a href={site.emailHref} class="flex items-center gap-2 text-white/80 transition-colors duration-200 hover:text-primary">
              <svg class="contact-icon" aria-hidden="true"><use href="#i-mail"></use></svg>{site.email}</a
            >
          </li>
          <li class="flex items-center gap-2 text-white/80">
            <svg class="contact-icon" aria-hidden="true"><use href="#i-pin"></use></svg>{site.address}
          </li>
          <li class="flex items-center gap-2 text-white/80">
            <svg class="contact-icon" aria-hidden="true"><use href="#i-clock"></use></svg>{site.worktime}
          </li>
        </ul>
      </address>
    </div>

    <div class="flex flex-col gap-2 border-t border-white/10 py-6 text-meta text-white/65 sm:flex-row sm:justify-between">
      <p>© 2002–2026 Токарка Про. Все права защищены.</p>
      <p>Оплата по безналичному расчёту. Работаем с юридическими лицами и ИП.</p>
    </div>
  </div>
</footer>
