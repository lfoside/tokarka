---
import { site } from '../data/site';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-default.png' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

/** Путь к шрифту с учётом base: GitHub Pages-демо живёт в подпапке репозитория */
const font = (file: string) => {
  const base = import.meta.env.BASE_URL;
  return (base.endsWith('/') ? base : base + '/') + 'fonts/' + file;
};

/** Микроразметка Schema.org LocalBusiness */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description,
  url: Astro.site,
  telephone: '+78005353535',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Москва',
    addressRegion: 'Москва и Московская область',
    addressCountry: 'RU',
  },
  openingHours: 'Mo-Fr 09:00-18:00',
  foundingDate: '2002',
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16181c" />
    <!-- ВРЕМЕННО: демо-режим (GitHub Pages) — страница закрыта от индексации.
         Снять перед SEO-запуском на tokarka.pro: чек-лист в DEMO-DEPLOY.md -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23f66b17' stroke-width='2' stroke-linecap='round'%3E%3Ccircle cx='12' cy='12' r='3'/%3E%3Cpath d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'/%3E%3C/svg%3E"
      type="image/svg+xml"
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="ru_RU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Флаг наличия JS: reveal-анимации активны только с ним -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Шрифты: preload критичного (Oswald — трафаретные заголовки; Manrope — текст) -->
    <link rel="preload" as="font" type="font/woff2" href={font('oswald-cyrillic.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font('oswald-latin.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font('manrope-cyrillic.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font('manrope-latin.woff2')} crossorigin />

    <!-- Layout inversion: точечная инжекция микроразметки из тела страницы -->
    <slot name="head" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="antialiased">
    <IconSprite />
    <Header />

    <main id="top">
      <slot />
    </main>

    <Footer />

    <!-- Мобильное меню: легковесный Vanilla JS (единственный интерактив,
         кроме плавного скролла), без бандла -->
    <script>
      (function () {
        var toggle = document.getElementById('menu-toggle');
        var menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;

        var toggleEl = toggle as HTMLElement;
        var menuEl = menu as HTMLElement;
        var use = toggleEl.querySelector('use');

        function setOpen(open: boolean) {
          menuEl.hidden = !open;
          toggleEl.setAttribute('aria-expanded', String(open));
          toggleEl.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
          if (use) use.setAttribute('href', open ? '#i-close' : '#i-menu');
          // Блокируем прокрутку страницы под открытым меню
          document.documentElement.style.overflow = open ? 'hidden' : '';
        }

        toggleEl.addEventListener('click', function () {
          setOpen(menuEl.hidden);
        });

        // Закрываем меню после перехода по ссылке
        menuEl.addEventListener('click', function (event) {
          if ((event.target as Element | null)?.closest('a')) setOpen(false);
        });

        // Закрываем по Escape и при уходе фокуса
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && !menuEl.hidden) {
            setOpen(false);
            toggleEl.focus();
          }
        });

        document.addEventListener('click', function (event) {
          if (menuEl.hidden) return;
          var target = event.target as Node | null;
          if (target && !menuEl.contains(target) && !toggleEl.contains(target)) setOpen(false);
        });

        // На широких экранах меню всегда закрыто
        var desktop = window.matchMedia('(min-width: 1280px)');
        var onChange = function (event: MediaQueryListEvent) {
          if (event.matches) setOpen(false);
        };
        if (desktop.addEventListener) desktop.addEventListener('change', onChange);
      })();
    </script>

    <!-- Появление секций при скролле: IntersectionObserver, минимум JS.
         .is-visible и transition — в global.css (правило 4.3). -->
    <script>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
